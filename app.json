{
  "expo": {
    "name": "Shepherd",
    "slug": "shepherd",
    "version": "1.3.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "io.bytehouse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "developmentClient": {
      "silentLaunch": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/custom_splash_icon.png",
      "resizeMode": "cover"
    },
    "fonts": [
      {
        "asset": "./assets/fonts/Feather Bold.ttf"
      },
      {
        "asset": "./assets/fonts/DIN Next Rounded LT W01 Regular.ttf"
      },
      {
        "asset": "./assets/fonts/Nunito-Bold.ttf"
      },
      {
        "asset": "./assets/fonts/Nunito-Black.ttf"
      },
      {
        "asset": "./assets/fonts/Nunito-Medium.ttf"
      },
      {
        "asset": "./assets/fonts/Nunito-Regular.ttf"
      },
      {
        "asset": "./assets/fonts/Nunito-BlackItalic.ttf"
      }
    ],
    "ios": {
      "enableRiveRuntime": true,
      "enableJSEngine": false,
      "bundleIdentifier": "second.round.shepherd",
      "buildNumber": "41",
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "15.1",
      "appleTeamId": "FY756JUW9K",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Shepherd needs camera access to create your player card and generate personalized workout plans based on your physique.",
        "NSPhotoLibraryUsageDescription": "Shepherd needs photo library access to create your player card and assess your fitness level for personalized workout recommendations.",
        "NSMicrophoneUsageDescription": "This app plays background music and requires audio capabilities. Microphone access is not used."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.shepherd.widget.streak"
        ]
      },
      "associatedDomains": [],
      "appExtensions": [
        {
          "targetName": "ShepherdStreakWidget",
          "bundleIdentifier": "second.round.shepherd.widget",
          "entitlements": {
            "com.apple.security.application-groups": [
              "group.shepherd.widget.streak"
            ]
          }
        }
      ]
    },
    "android": {
      "enableRiveRuntime": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "second.round.shepherd",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/custom_splash_icon.png",
          "resizeMode": "cover",
          "imageWidth": 230,
          "imageHeight": 230
        }
      ],
      "@react-native-firebase/app",
      "expo-font",
      "expo-apple-authentication",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-custom-assets",
        {
          "assetsPaths": [
            "./assets/riveAnimations/"
          ]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false,
        "ignoreFiles": [
          "app/api/**/*.{ts,tsx}",
          "app/hooks/**/*.{ts,tsx}",
          "app/models/**/*.{ts,tsx}",
          "app/stores/**/*.{ts,tsx}",
          "app/types/**/*.{ts,tsx}",
          "app/utils/**/*.{ts,tsx}"
        ]
      },
      "eas": {
        "projectId": "e55bbb73-0fba-4eb9-92ec-9433da72c8c7"
      },
      "googleWebClientId": "226457915179-tbsa7rptki8iedbirm5mp0ug9dob8kf0.apps.googleusercontent.com"
    },
    "owner": "second-round"
  }
}