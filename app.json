{
  "expo": {
    "name": "Shepherd",
    "slug": "shepherd",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "shepherd",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "developmentClient": {
      "silentLaunch": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF4D9"
    },
    "ios": {
      "bundleIdentifier": "second.round.shepherd",
      "buildNumber": "41",
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "15.1",
      "appleTeamId": "FY756JUW9K",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Shepherd needs camera access to create your player card and generate personalized workout plans based on your physique.",
        "NSPhotoLibraryUsageDescription": "Shepherd needs photo library access to create your player card and assess your fitness level for personalized workout recommendations."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.shepherd.widget.streak"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "second.round.shepherd",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF3D9",
          "imageWidth": 196
        }
      ],
      "@react-native-firebase/app",
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false,
        "ignoreFiles": [
          "app/api/**/*.{ts,tsx}",
          "app/hooks/**/*.{ts,tsx}",
          "app/models/**/*.{ts,tsx}", 
          "app/stores/**/*.{ts,tsx}",
          "app/types/**/*.{ts,tsx}",
          "app/utils/**/*.{ts,tsx}"
        ]
      },
      "eas": {
        "projectId": "e55bbb73-0fba-4eb9-92ec-9433da72c8c7"
      }
    },
    "owner": "second-round"
  }
}
