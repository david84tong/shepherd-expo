{
  "expo": {
    "name": "Shepherd",
    "slug": "shepherd",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "Shepherd",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "io.tryshepherd.ios",
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "15.1",
      "appleTeamId": "45ZFHZF3MY",
      "usesAppleSignIn": false,
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Arise needs camera access to create your player card and generate personalized workout plans based on your physique.",
        "NSPhotoLibraryUsageDescription": "Arise needs photo library access to create your player card and assess your fitness level for personalized workout recommendations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "llc.sololeveling.Arise",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "@react-native-firebase/app"

    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "93cd2b82-ddbb-4bec-842d-115770cd12e8"
      }
    },
    "owner": "stealth-company"
  }
}
