rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Base rule - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User collection rules
    match /users/{userId} {
      // Allow read/write if the user is authenticated and accessing their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Optional: Allow creation of new user documents during sign up
      allow create: if request.auth != null 
        && request.auth.uid == userId 
        && request.resource.data.uid == userId;
    }
    
    // Devotionals collection rules
    match /devotionals/{devotionalId} {
      // Allow authenticated users to create, read, update, and delete their own devotionals
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow creation of new devotionals if the user is authenticated and setting themselves as userId
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId;
    }
    
    // Feedback collection rules
    match /feedback/{feedbackId} {
      // Allow authenticated users to create feedback documents
      allow create: if request.auth != null;
      
      // Allow users to read their own feedback (optional)
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
} 