rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Base rule - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User collection rules
    match /users/{userId} {
      // Allow read/write if the user is authenticated and accessing their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Optional: Allow creation of new user documents during sign up
      allow create: if request.auth != null 
        && request.auth.uid == userId 
        && request.resource.data.uid == userId;
    }
    
    // Daily Devotionals collection rules
    match /dailyDevotionals/{devotionalId} {
      // Allow all authenticated users to read devotionals
      allow read: if request.auth != null;
      
      // Only allow admins to write devotionals (you can adjust this based on your needs)
      allow write: if false; // For now, no writes from client
    }
    
    // Feedback collection rules
    match /feedback/{feedbackId} {
      // Allow authenticated users to create feedback documents
      allow create: if request.auth != null;
      
      // Allow users to read their own feedback (optional)
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Invite Links collection rules
    match /inviteLinks/{inviteLinkId} {
      // Creation: only by the creator
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.userId;

      // Read, update, delete: only by the creator
      allow read, update, delete: if request.auth != null &&
                                   request.auth.uid == resource.data.userId;

      // Limited public read access (for processing invite codes)
      // Only allow if the document doesn't contain sensitive info
      allow get: if request.auth != null;
    }

    // Friends collection rules
    match /friends/{friendId} {
      // Creation: only if the user is involved
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.friendId);

      // Individual read: only if the user is one of the two friends
      allow get: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.friendId);

      // Update, delete: only if the user is one of the two friends
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == resource.data.friendId);

      // List queries: allow queries where the user is involved
      // This is necessary for loadFriends() and checking existing friendships
      allow list: if request.auth != null;
    }
  }
} 